# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Custom plugins (our code, not a Composer dependency)
!web/app/plugins/shop-checkout/
!web/app/plugins/shop-checkout/**
!web/app/plugins/shop-payment-gateways/
!web/app/plugins/shop-payment-gateways/**
!web/app/plugins/shop-account/
!web/app/plugins/shop-account/**
!web/app/plugins/shop-api/
!web/app/plugins/shop-api/**
!web/app/plugins/site-blocks/
!web/app/plugins/site-blocks/**
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
# Wordfence runtime data (WAF rules, GeoIP DB, logs) — regenerated on activation
web/app/wflogs/*

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml
