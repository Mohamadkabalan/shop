DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_HOST='127.0.0.1' # Use if you encounter mysqli 2002 / socket connection issues
# DB_PREFIX='wp_'

# Redis (object cache) connection — see docker-compose.yml for the local "redis" service.
# Caching itself is enabled/disabled per environment (config/environments/), not here —
# these are just connection details, applied via WP-CLI (bin/shop-cache-configure.php).
# REDIS_HOST='redis'
# REDIS_PORT='6379'
# REDIS_DATABASE='0'
# REDIS_PREFIX='shop'

# Origin of the separate headless frontend (React/Next.js) consuming web/app/plugins/shop-api.
# Must be an exact scheme+host+port match — see that plugin's src/Cors.php. Defaults to WP_HOME
# (same-origin) if unset.
# SHOP_FRONTEND_URL='http://localhost:3000'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# WooCommerce store config (placeholders — replace before running bin/woocommerce-setup.sh)
# Applied via WP-CLI instead of the setup wizard; see bin/woocommerce-configure.php
WC_CURRENCY='USD'
WC_STORE_ADDRESS='123 Placeholder St'
WC_STORE_ADDRESS_2=''
WC_STORE_CITY='Placeholder City'
WC_STORE_POSTCODE='00000'
# Format: COUNTRY:STATE, e.g. US:CA — see https://github.com/woocommerce/woocommerce/blob/trunk/plugins/woocommerce/i18n/states.php
WC_STORE_COUNTRY='US:CA'
WC_WEIGHT_UNIT='kg'
WC_DIMENSION_UNIT='cm'

# Shipping zone placeholder — single zone, rename and price it for real before going live
WC_SHIPPING_ZONE_NAME='Default Zone'
# 2-letter country code the zone applies to
WC_SHIPPING_ZONE_COUNTRY='US'
WC_SHIPPING_FLAT_RATE_COST='0'
# Free shipping is added to the same zone alongside flat rate. WC_SHIPPING_FREE_SHIPPING_REQUIRES
# is one of: '' (always free), 'coupon', 'min_amount', 'either', 'both'.
WC_SHIPPING_FREE_SHIPPING_MIN_AMOUNT='100'
WC_SHIPPING_FREE_SHIPPING_REQUIRES='min_amount'

# Tax settings — applied via WP-CLI (see bin/woocommerce-configure.php). Rate defaults to 0%
# so a fresh environment never accidentally charges tax; set WC_TAX_RATE_PERCENT before going live.
WC_TAX_ENABLED='yes'
WC_TAX_PRICES_INCLUDE_TAX='no'
# One of: shipping, billing, base
WC_TAX_BASED_ON='shipping'
WC_TAX_ROUND_AT_SUBTOTAL='no'
# One of: incl, excl
WC_TAX_DISPLAY_SHOP='excl'
WC_TAX_DISPLAY_CART='excl'
# One of: single, itemized
WC_TAX_TOTAL_DISPLAY='itemized'
# Standard-rate tax row: 2-letter country code, or '*' for all countries.
WC_TAX_RATE_COUNTRY='US'
# State/province code, or '*' for all states within the country.
WC_TAX_RATE_STATE='*'
WC_TAX_RATE_NAME='Tax'
WC_TAX_RATE_PERCENT='0'
WC_TAX_RATE_PRIORITY='1'
WC_TAX_RATE_COMPOUND='no'
WC_TAX_RATE_SHIPPING='yes'

# Product reviews — applied via WP-CLI (see bin/shop-reviews-configure.php). Verified-only and
# moderation both default to "yes"; comment_moderation/comment_previously_approved/comment_max_links
# are WordPress-wide settings (also affect comments on any blog posts/pages, not just reviews).
WC_REVIEWS_ENABLED='yes'
WC_REVIEWS_RATING_ENABLED='yes'
WC_REVIEWS_RATING_REQUIRED='yes'
WC_REVIEWS_VERIFIED_LABEL='yes'
# Hides the review form from anyone who hasn't bought the product.
WC_REVIEWS_VERIFIED_ONLY='yes'
# Hold every new review for manual approval before it's public.
WC_REVIEWS_REQUIRE_MODERATION='yes'
# Auto-approve repeat reviews from someone whose earlier review was already approved.
WC_REVIEWS_AUTO_APPROVE_RETURNING='yes'
# Auto-hold reviews containing more than this many links (spam signal).
WC_REVIEWS_MAX_LINKS='2'

# Payment gateway credentials — read at runtime by web/app/plugins/shop-payment-gateways,
# never written into wp_options as the source of truth. Sandbox/test mode is automatic
# whenever WP_ENV isn't 'production' — fill in whichever pair matches the active mode.
#
# Stripe: https://dashboard.stripe.com/test/apikeys (test) / https://dashboard.stripe.com/apikeys (live)
STRIPE_TEST_PUBLISHABLE_KEY='pk_test_...'
STRIPE_TEST_SECRET_KEY='sk_test_...'
STRIPE_TEST_WEBHOOK_SECRET='whsec_...'
STRIPE_PUBLISHABLE_KEY='pk_live_...'
STRIPE_SECRET_KEY='sk_live_...'
STRIPE_WEBHOOK_SECRET='whsec_...'

# PayPal Payments: https://developer.paypal.com/dashboard/applications (create both a
# Sandbox and a Live app to get these pairs)
PAYPAL_SANDBOX_CLIENT_ID=''
PAYPAL_SANDBOX_CLIENT_SECRET=''
PAYPAL_CLIENT_ID=''
PAYPAL_CLIENT_SECRET=''
